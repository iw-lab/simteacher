rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 🔴 사이트 주인 — 「심쌤 답변」 배지를 달 수 있는 유일한 계정.
    //    Firestore 규칙에는 전역 상수가 없다(교차검증 지적). 함수로 감싼다.
    //    이 값은 비밀이 아니다 — uid 는 식별자일 뿐이고, 계정의 힘은 비밀번호에서 온다.
    //    ⚠️ 아래가 자리표시자인 동안에는 «아무도» 배지를 달 수 없다(안전한 기본값).
    function ownerUid() { return 'OWNER_UID_NOT_SET'; }
    function isOwner() { return request.auth != null && request.auth.uid == ownerUid(); }
    // Contacts — 비공개 문의함: 누구나 생성 가능(필드·크기 검증), 열람은 관리자(Firebase 콘솔)만
    // name/email/school 은 선택(빈 문자열 허용), title/message 만 필수. 읽기는 항상 차단.
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'school', 'title', 'message', 'createdAt', 'status'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.school is string && request.resource.data.school.size() <= 100
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    // Guestbook — 공개 방명록: 누구나 읽고, 익명 로그인한 브라우저면 누구나 쓴다.
    // 삭제는 "쓴 그 브라우저"만 가능하다 — uid 는 클라이언트가 위조할 수 없다(request.auth).
    // 수정은 막는다: 착한 글로 통과시킨 뒤 내용을 바꿔치기하는 경로를 아예 없앤다.
    match /guestbook/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['nickname', 'message', 'color', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1 && request.resource.data.nickname.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 500
        && request.resource.data.color in ['yellow', 'mint', 'sky', 'pink', 'lilac']
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Comments — 글별 공개 댓글. 방명록과 같은 계약(익명 uid · 수정 금지 · 본인만 삭제)에서 출발하되,
    // 교차검증에서 잡힌 두 가지를 더 막았다.
    //
    // 🔴 **uid 를 댓글 문서에 두지 않는다.** 두면 「익명」으로 쓴 댓글과 실명으로 쓴 댓글이
    //    같은 uid 로 묶여, 누구나 대조만으로 익명 작성자를 특정할 수 있다. 아이들이 쓰는
    //    사이트에서 이건 그냥 익명이 아닌 것이다. 소유권은 아래 commentOwners 에 따로 두고,
    //    그 문서는 «본인만» 읽을 수 있다.
    // 🔴 **list 에 상한을 건다.** read 를 통째로 열면 클라이언트의 limit 은 아무 의미가 없고
    //    컬렉션 전체를 반복 스캔당할 수 있다(읽기 비용).
    // 🔴 공백만 있는 글·이름을 막는다. 클라이언트의 trim 은 SDK 직접 호출로 우회된다.
    match /comments/{commentId} {
      allow get: if true;
      allow list: if request.query.limit <= 200;
      //
      // ── 답글(2026-09-18) ──────────────────────────────────────────────────
      // 🔴 **깊이 2 는 규칙이 강제한다.** parentId 의 «글자 모양»만 보면 아무 소용이 없다 —
      //    답글의 id 를 parentId 로 넣어 3단·4단을 만들 수 있고, 있지도 않은 부모를 가리킬 수도
      //    있다(8way 교차검증에서 4계열 전원이 지적). 그래서 부모를 실제로 열어 본다.
      // 🔴 **'guestbook' 은 예약 slug 다.** 그 칸에는 반드시 parentId 가 있어야 한다 —
      //    안 그러면 「guestbook」이라는 이름의 블로그 글 댓글이 방명록 답글 칸에 섞인다.
      // 🔴 **owner 는 있거나 없거나 둘 중 하나.** false 를 실으면 통째로 거절된다 —
      //    클라이언트는 키 자체를 조건부로 넣어야 한다.
      // 🔴 **소유권 문서 없이 태어날 수 없다.** 예전엔 댓글만 만들어 두면 나중에 아무나
      //    같은 id 의 commentOwners 를 자기 uid 로 만들어 «내 것»이라 주장해 지울 수 있었다.
      //    같은 배치에 소유권 문서가 있는지 getAfter 로 확인해 그 대상 자체를 없앤다.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['slug', 'nickname', 'message', 'createdAt', 'parentId', 'owner'])
        && request.resource.data.slug is string
        && request.resource.data.slug.size() >= 1 && request.resource.data.slug.size() <= 100
        && request.resource.data.slug.matches('^[a-z0-9-]+$')
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 20
        && (request.resource.data.nickname == '' || request.resource.data.nickname.matches('.*\\S.*'))
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 1000
        && request.resource.data.message.matches('.*\\S.*')
        && request.resource.data.createdAt == request.time
        // 주인 배지 — 주인 계정으로 로그인했을 때만
        && (!('owner' in request.resource.data)
            || (request.resource.data.owner == true && isOwner()))
        // 주인이 아니면 「심쌤」을 사칭하는 이름을 쓸 수 없다(배지 옆에 같은 글자가 놓이면 구별이 안 된다)
        && (('owner' in request.resource.data) || !request.resource.data.nickname.matches('.*심쌤.*'))
        // 예약 slug: 방명록 칸에는 반드시 부모가 있다
        && (request.resource.data.slug != 'guestbook' || 'parentId' in request.resource.data)
        // 부모 검사 — 없으면 최상위 댓글, 있으면 «진짜 있는 최상위» 여야 한다
        && (!('parentId' in request.resource.data)
            || (request.resource.data.parentId is string
                && request.resource.data.parentId.size() >= 1
                && request.resource.data.parentId.size() <= 64
                && request.resource.data.parentId.matches('^[A-Za-z0-9_-]+$')
                && (request.resource.data.slug == 'guestbook'
                    ? exists(/databases/$(database)/documents/guestbook/$(request.resource.data.parentId))
                    : (exists(/databases/$(database)/documents/comments/$(request.resource.data.parentId))
                       && !('parentId' in get(/databases/$(database)/documents/comments/$(request.resource.data.parentId)).data)))))
        && getAfter(/databases/$(database)/documents/commentOwners/$(commentId)).data.uid == request.auth.uid;
      // 소유권 문서를 열어 본인인지 확인한다. 소유권 문서가 없으면(옛 데이터·유실) 지울 수 없고,
      // 그때는 관리자가 Firebase 콘솔에서 지운다.
      // 주인은 모더레이션을 위해 지울 수 있다 — 안 그러면 악성 답글·고아 답글을 콘솔로만 치운다.
      allow delete: if isOwner()
        || (request.auth != null
            && exists(/databases/$(database)/documents/commentOwners/$(commentId))
            && get(/databases/$(database)/documents/commentOwners/$(commentId)).data.uid == request.auth.uid);
      allow update: if false;
    }

    // 댓글 소유권 — 「이 댓글은 누구 것인가」만 담는다. **본인만 읽는다.**
    // 공개 댓글에서 uid 를 떼어 내 익명성을 지키면서도 삭제 권한은 서버가 검사할 수 있게 하는 자리.
    match /commentOwners/{commentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Stats — 방문자 수. 문서는 'total' 과 'd_YYYYMMDD' 둘뿐이고, 값은 +1 씩만 움직인다.
    // increment(1) 의 결과값을 규칙이 그대로 보므로 "한 번에 1만" 을 강제할 수 있다.
    match /stats/{statId} {
      allow read: if true;
      allow create: if (statId == 'total' || statId.matches('^d_[0-9]{8}$'))
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if (statId == 'total' || statId.matches('^d_[0-9]{8}$'))
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Clicks — 어떤 카드가 눌렸는지. 전체 누적과 날짜별을 따로 쌓는다.
    match /clicks/{slug} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['slug', 'name', 'count'])
        && request.resource.data.slug == slug && slug.size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['slug', 'name', 'count'])
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /clicksDaily/{dailyId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'slug', 'name', 'count'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{8}$')
        && dailyId == request.resource.data.date + '__' + request.resource.data.slug
        && request.resource.data.slug is string && request.resource.data.slug.size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['date', 'slug', 'name', 'count'])
        && request.resource.data.date == resource.data.date
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // 글 조회수 — 글 하나당 문서 하나, 값은 +1 씩만 움직인다(clicks 와 같은 계약).
    // 읽기는 열되 list 에 상한을 건다: read 를 통째로 열면 컬렉션 전체를 반복 스캔당한다(읽기 비용).
    // 정확한 UV 가 아니다 — 같은 브라우저는 하루 한 번만 센다(그 판단은 클라이언트가 한다).
    match /postViews/{slug} {
      allow get: if true;
      allow list: if request.query.limit <= 200;
      allow create: if request.resource.data.keys().hasOnly(['slug', 'count'])
        && request.resource.data.slug == slug
        && slug.matches('^[a-z0-9-]+$') && slug.size() <= 100
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['slug', 'count'])
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // 그 외 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
