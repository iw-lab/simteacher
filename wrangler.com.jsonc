{
  // 옛 주소 ssamzip.com 문 — 사람에겐 사이트 그대로, 검색엔진엔 noindex(edge-com/worker.js). korea 계정.
  // 배포 = bash tools/deploy-com.sh (.com 전용 빌드 → out-com → .kr 글자 0 검사 → 올림 → 본 주소로 되돌려 빌드)
  "name": "ssamzip-com",
  "main": "edge-com/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./out-com", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "none", "run_worker_first": true },
  "routes": [
    { "pattern": "ssamzip.com", "custom_domain": true },
    { "pattern": "www.ssamzip.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true }
}
