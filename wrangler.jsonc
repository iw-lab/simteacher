{
  // 본 주소 ssamzip.kr(2026-11-03~) — korea 계정(이름 관리와 같은 계정). 배포 = npm run deploy
  // 옛 ssamzip.com 은 따로 «ssamzip-com» 워커(wrangler.com.jsonc · tools/deploy-com.sh) — .kr 로 넘기지 않는다
  "name": "ssamzip",
  "main": "edge/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./out", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "none", "run_worker_first": true },
  "routes": [
    { "pattern": "ssamzip.kr", "custom_domain": true },
    { "pattern": "www.ssamzip.kr", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
